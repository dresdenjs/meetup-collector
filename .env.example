# required: slug of the Meetup group, as in meetup.com/<slug>/
GROUP_SLUG=dresdenjs-io-javascript-user-group

# optional, defaults shown
# BASE_URL=https://www.meetup.com/
# TARGET=./dist
# placeholders: %id%, %date% (ISO 8601), %day% (YYYY-MM-DD)
# FILE_NAME=%day%-meetup.md
# LIMIT_UPCOMING=
# LIMIT_PAST=
# DEBUG=1
